<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboticarm_description</name>
  <version>0.0.0</version>
  <description>The roboticarm_description package</description>
  <maintainer email="namanpatel024@gmail.com">Naman Patel</maintainer>
  <license>BSD</license>

  <author email="namanpatel024@gmail.com">Naman Patel</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- Lets gz-sim resolve model://roboticarm_description/meshes/*.stl (read by
         both the classic-era GazeboRosPaths helper still used in ros_gz_sim's
         gz_sim.launch.py, and Fortress's own resource-path search). -->
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
